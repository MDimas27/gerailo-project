{
  "name": "@gerailo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "build:bundle": "wrangler deploy --dry-run --env staging --outdir dist",
    "typecheck": "tsc --noEmit",
    "deploy:staging": "pnpm --filter @gerailo/web build && wrangler deploy --env staging",
    "deploy:production": "pnpm --filter @gerailo/web build && wrangler deploy --env production"
  },
  "dependencies": {
    "@gerailo/shared": "workspace:*",
    "@gerailo/supabase": "workspace:*",
    "@supabase/supabase-js": "^2.119.2",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  }
}
