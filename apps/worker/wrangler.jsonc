{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gerailo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "gerailo-staging",
      "vars": {
        "APP_ENV": "staging"
      }
    },
    "production": {
      "name": "gerailo-production",
      "vars": {
        "APP_ENV": "production"
      }
    }
  }
}
