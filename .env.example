# Contoh konfigurasi environment Gerailo (Task 1 M7 — split per environment).
# Salin ke .env.staging / .env.production (keduanya di-gitignore, JANGAN di-commit).
# CI TIDAK membaca file ini: nilai di-inject via GitHub Variables/Secrets.
#
# CLOUDFLARE_API_TOKEN tidak diletakkan di file env:
#   - CI  : GitHub Secret `CLOUDFLARE_API_TOKEN` (token aktif hasil rotasi 27 Nov 2026).
#   - Lokal: `wrangler login`, karena token lama di .env lama sudah 401/dicabut.

# --- Supabase (per environment: wdpkh… = staging, fqncax… = produksi) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable/anon key — publik, masuk bundle>
SUPABASE_SERVICE_ROLE_KEY=<service_role — HANYA Worker lokal, jangan ke browser>
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# --- Observability (boleh sama antar environment) ---
SENTRY_DSN=https://<key>@<o>.ingest.sentry.io/<project>
VITE_POSTHOG_KEY=<posthog public key>
VITE_POSTHOG_HOST=https://<posthog host>

# --- LLM (NVIDIA NIM; key hanya dipakai Worker) ---
LLM_API_KEY=nvapi-<key>
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
